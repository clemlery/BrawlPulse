# Environment for running the backend outside Docker with `./gradlew run`
# (copy to backend/.env). Loaded at startup by dotenv-kotlin.
# Postgres can still run in Docker: `docker compose up db`.

API_PORT=4000
API_HOST=localhost
API_SCHEME=http

# Outside Docker the database is reached through the port published on the host.
DB_JDBC_URL=jdbc:postgresql://localhost:5432/brawlpulse
POSTGRES_USER=backend
POSTGRES_PASSWORD=change-me

BH_API_KEY=
ADMIN_TOKEN=
