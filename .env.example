# BrawlPulse — environment for `docker compose` (copy to .env and fill in).
# Read by the `db` and `server` services through `env_file: .env`.
# Never commit the real .env.

# --- PostgreSQL (db service) -------------------------------------------------
# Only applied when the Postgres volume is created for the first time.
# db/init/02_create_user.sql grants privileges to the role "backend" on the
# database "brawlpulse": keep these two values unless you update that script.
POSTGRES_DB=brawlpulse
POSTGRES_USER=backend
POSTGRES_PASSWORD=change-me

# --- Ktor server (server service) --------------------------------------------
# Port the API listens on, also published on the host.
API_PORT=4000
# Ignored in Docker (docker-compose.yml forces 0.0.0.0); used by `./gradlew run`.
API_HOST=localhost
API_SCHEME=http

# Optional. Defaults to jdbc:postgresql://db:5432/brawlpulse (the compose db service).
# DB_JDBC_URL=

# Brawlhalla API key (request one from the Brawlhalla developers).
BH_API_KEY=

# Bearer token protecting POST /admin/snapshot/run. Generate one with:
#   openssl rand -hex 32
ADMIN_TOKEN=
